{
  "SourceSecrets": {
    "Sources": {
      "source-name": "..."
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest",
    
    "DeliveryQueue": "webhook-deliveries",
    "RetryQueue": "webhook-deliveries-retry",
    "DeadLetterQueue": "webhook-deliveries-dlq",
    
    "RetryAttempts": 5,
    "RetryDelaySeconds": "00:00:30"
  },
  "Serilog": {
    "ServiceName": "WebhookGateway.API",
    "LokiUrl": "http://localhost:3100",
    "MinimumLevel": "Information",
    "Overrides": {
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
